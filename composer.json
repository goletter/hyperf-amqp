{
    "name": "goletter/hyperf-amqp",
    "description": "Hyperf 分片 AMQP：串行键分片、重试、死信与运维命令。",
    "type": "library",
    "version": "1.1.0",
    "license": "MIT",
    "authors": [
        {
            "name": "goletter",
            "email": "goletter@outlook.com"
        }
    ],
    "keywords": [
        "php",
        "hyperf",
        "amqp",
        "rabbitmq",
        "sharded",
        "dlq",
        "goletter"
    ],
    "require": {
        "php": ">=8.1",
        "goletter/hyperf-utils": "^1.0",
        "hyperf/amqp": "~3.1.0",
        "hyperf/command": "~3.1.0",
        "hyperf/context": "~3.1.0",
        "hyperf/contract": "~3.1.0",
        "hyperf/coroutine": "~3.1.0",
        "hyperf/process": "~3.1.0",
        "hyperf/framework": "3.1.*",
        "psr/container": "^1.0 || ^2.0"
    },
    "autoload": {
        "psr-4": {
            "Goletter\\Amqp\\": "src/"
        },
        "files": [
            "src/Functions.php"
        ]
    },
    "extra": {
        "hyperf": {
            "config": "Goletter\\Amqp\\ConfigProvider"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    }
}
